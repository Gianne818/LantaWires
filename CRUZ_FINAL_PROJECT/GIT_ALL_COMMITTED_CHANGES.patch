+  .home-hero { border-radius: var(--r-lg); padding: 1.5rem 1.6rem; }
+  .metrics-grid { margin-top: 0; gap: 1rem; }
+  .metric-card { border-radius: var(--r-md); padding: 1.2rem; display: flex; flex-direction: column; gap: .35rem; }
