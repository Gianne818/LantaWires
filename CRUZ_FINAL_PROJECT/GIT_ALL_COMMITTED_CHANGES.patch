+  .metric-num { font-variant-numeric: tabular-nums; line-height: 1; align-self: flex-start; margin: .2rem 0 .1rem; }
+  .section-sub { color: var(--ink-2); line-height: 1.45; }
+  .ticket-chip { font-variant-numeric: tabular-nums; }
